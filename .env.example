# ==========================================================================
# Apex Software Engineering - Environment Variables
# ==========================================================================

# 1. Database Connection (MySQL 8)
DATABASE_URL="mysql://apex_user:apex_password@localhost:3306/apex_company_db"

# 2. JWT Secrets (Generate secure random keys for production)
JWT_SECRET="apex-prod-secret-key-change-before-deployment"
JWT_REFRESH_SECRET="apex-prod-refresh-secret-key-change-before-deployment"

# 3. Initial Admin User Credentials (Seeded on first migration)
ADMIN_EMAIL="admin@apexsoftware.lk"
ADMIN_PASSWORD="AdminPass123!"

# 4. REST API Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:4000,http://localhost:4200"

# 5. SMTP Configuration for Contact Form Notifications (Optional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="smtp_username"
SMTP_PASS="smtp_password"
SMTP_SECURE="false"
NOTIFICATION_EMAIL="contact@apexsoftware.lk"
