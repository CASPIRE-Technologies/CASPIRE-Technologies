# Copy this file to .env and fill in real secrets before deploying

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=CASPIRE_company_db
MYSQL_USER=CASPIRE_user
MYSQL_PASSWORD=CASPIRE_password

# App database URL (used by backend and prisma)
# Example for MySQL: mysql://user:pass@host:3306/dbname
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}

# JWT secrets
JWT_SECRET=replace-with-prod-jwt-secret
JWT_REFRESH_SECRET=replace-with-prod-refresh-secret

# Admin
ADMIN_EMAIL=admin@CASPIREsoftware.lk
ADMIN_PASSWORD=AdminPass123!

# CORS origins (comma-separated)
CORS_ORIGIN="http://localhost:4000,http://localhost:4200"
